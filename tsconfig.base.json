{
  "compileOnSave": false,
  "compilerOptions": {
    "moduleResolution": "Node",
    "target": "ESNext",
    "module": "ESNext",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@useful-apps/shared/ui-components": [
        "libs/shared/ui-components/src/index.ts"
      ],
      "@useful-apps/shared/types": [
        "libs/shared/types/src/index.ts"
      ],
      "@useful-apps/shared/utils": [
        "libs/shared/utils/src/index.ts"
      ],
      "@useful-apps/shared/services": [
        "libs/shared/services/src/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "supabase"
  ]
}
