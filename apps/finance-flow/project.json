{
    "name": "finance-flow",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "apps/finance-flow/src",
    "targets": {
        "build": {
            "executor": "@nx/vite:build",
            "outputs": [
                "{options.outputPath}"
            ],
            "options": {
                "root": "apps/finance-flow",
                "outputPath": "dist/apps/finance-flow",
                "configFile": "apps/finance-flow/vite.config.ts"
            }
        },
        "serve": {
            "executor": "@nx/vite:dev-server",
            "options": {
                "buildTarget": "finance-flow:build",
                "configFile": "apps/finance-flow/vite.config.ts"
            }
        },
        "preview": {
            "executor": "@nx/vite:preview",
            "options": {
                "buildTarget": "finance-flow:build"
            }
        }
    }
}